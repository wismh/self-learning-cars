<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.road_mesh.kicker}"/>
    <Label class="h-title" text="{tr help.road_mesh.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.road_mesh.p1}"/>
    <Label class="h-p" text="{tr help.road_mesh.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="v_L(i) = p(i) + \vec{n}(i) \cdot w_L(i), \quad v_R(i) = p(i) - \vec{n}(i) \cdot w_R(i)"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="p(i)"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.road_mesh.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\vec{n}(i)"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.road_mesh.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="w_L, w_R"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.road_mesh.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.road_mesh.q0}"/>
            <Label class="h-a" text="{tr help.road_mesh.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.road_mesh.try}" command="{binding tryIt}"/>
</Stack>
