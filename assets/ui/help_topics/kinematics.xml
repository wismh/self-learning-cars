<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.kinematics.kicker}"/>
    <Label class="h-title" text="{tr help.kinematics.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.kinematics.p1}"/>
    <Label class="h-p" text="{tr help.kinematics.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="v_x = v \cos \theta, \quad v_y = v \sin \theta, \quad \omega = \delta_{\text{steer}} \cdot \omega_{\max} \cdot \frac{v}{v_{\max}}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="v"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.kinematics.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\theta"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.kinematics.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\delta_{\text{steer}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.kinematics.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.kinematics.q0}"/>
            <Label class="h-a" text="{tr help.kinematics.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.kinematics.try}" command="{binding tryIt}"/>
</Stack>
