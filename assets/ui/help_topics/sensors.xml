<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.sensors.kicker}"/>
    <Label class="h-title" text="{tr help.sensors.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.sensors.p1}"/>
    <Label class="h-p" text="{tr help.sensors.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="d_i = \min_{w \in W} \|p_{\text{car}} - p_{\text{hit}}(w, \vec{u}_i)\|, \quad i \in \{1, \ldots, 7\}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\vec{u}_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.sensors.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="W"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.sensors.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="p_{\text{hit}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.sensors.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.sensors.q0}"/>
            <Label class="h-a" text="{tr help.sensors.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.sensors.try}" command="{binding tryIt}"/>
</Stack>
