<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.ecs.kicker}"/>
    <Label class="h-title" text="{tr help.ecs.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.ecs.p1}"/>
    <Label class="h-p" text="{tr help.ecs.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="\text{Fixed} \to \text{Game} \to (\text{Sensors} \to \text{Brains} \to \text{Physics} \to \text{Evolution})"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\text{Fixed}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.ecs.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\text{Game}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.ecs.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\text{Sensors}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.ecs.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.ecs.q0}"/>
            <Label class="h-a" text="{tr help.ecs.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.ecs.try}" command="{binding tryIt}"/>
</Stack>
