<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.neural_network.kicker}"/>
    <Label class="h-title" text="{tr help.neural_network.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.neural_network.p1}"/>
    <Label class="h-p" text="{tr help.neural_network.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="h = \tanh(W_1 x + b_1), \quad y = \tanh(W_2 h + b_2)"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="x"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.neural_network.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="h"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.neural_network.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="y"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.neural_network.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.neural_network.q0}"/>
            <Label class="h-a" text="{tr help.neural_network.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.neural_network.try}" command="{binding tryIt}"/>
</Stack>
