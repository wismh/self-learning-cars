<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.fitness.kicker}"/>
    <Label class="h-title" text="{tr help.fitness.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.fitness.p1}"/>
    <Label class="h-p" text="{tr help.fitness.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="F = N_{\text{cp}} \cdot 100 + \left(1 - \frac{d_{\text{next}}}{W_{\text{road}}}\right) \cdot 50 + d_{\text{total}} \cdot 0.04"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="N_{\text{cp}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.fitness.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="d_{\text{next}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.fitness.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="d_{\text{total}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.fitness.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.fitness.q0}"/>
            <Label class="h-a" text="{tr help.fitness.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.fitness.try}" command="{binding tryIt}"/>
</Stack>
