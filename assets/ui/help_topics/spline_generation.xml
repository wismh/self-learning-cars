<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.spline_generation.kicker}"/>
    <Label class="h-title" text="{tr help.spline_generation.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.spline_generation.p1}"/>
    <Label class="h-p" text="{tr help.spline_generation.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="C(t) = \frac{1}{2} [ 2p_1 + (-p_0 + p_2)t + (2p_0 - 5p_1 + 4p_2 - p_3)t^2 + (-p_0 + 3p_1 - 3p_2 + p_3)t^3 ]"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="p_0, \ldots, p_3"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.spline_generation.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="t \in [0, 1]"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.spline_generation.legend1}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.spline_generation.q0}"/>
            <Label class="h-a" text="{tr help.spline_generation.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.spline_generation.try}" command="{binding tryIt}"/>
</Stack>
