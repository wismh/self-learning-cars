<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.checkpoints.kicker}"/>
    <Label class="h-title" text="{tr help.checkpoints.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.checkpoints.p1}"/>
    <Label class="h-p" text="{tr help.checkpoints.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="(p_{\text{car}} - c_k) \cdot \vec{t}_k \ge 0, \quad \|p_{\text{car}} - c_k\| \le 0.75 \cdot W_{\text{road}}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="c_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.checkpoints.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\vec{t}_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.checkpoints.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="W_{\text{road}}"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.checkpoints.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.checkpoints.q0}"/>
            <Label class="h-a" text="{tr help.checkpoints.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.checkpoints.try}" command="{binding tryIt}"/>
</Stack>
