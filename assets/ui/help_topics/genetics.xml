<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.genetics.kicker}"/>
    <Label class="h-title" text="{tr help.genetics.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.genetics.p1}"/>
    <Label class="h-p" text="{tr help.genetics.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="w_{\text{mut}} = w + N(0, \sigma^2), \quad w_{\text{cross}} = \alpha \cdot w_A + (1 - \alpha) \cdot w_B"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="N(0, \sigma^2)"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.genetics.legend0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\alpha"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.genetics.legend1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="w_A, w_B"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.genetics.legend2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.genetics.q0}"/>
            <Label class="h-a" text="{tr help.genetics.a0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.genetics.try}" command="{binding tryIt}"/>
</Stack>
